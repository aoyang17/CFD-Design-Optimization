#!MC 1410
$!SetStyleBase Factory
$!PlotType  = XYLine
$!FrameLayout 
  ShowBorder = No
  ShowHeader = No
  HeaderColor = Red
  XYPos
    {
    X = 1
    Y = 0.5
    }
  Width = 9
  Height = 1.5
$!ThreeDAxis 
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
$!GlobalTime 
  SolutionTime = 0
$!DeleteLineMaps 
$!ActiveLineMaps  =  [1]
$!GlobalLinePlot 
  DataLabels
    {
    DistanceSkip = 5
    }
  Legend
    {
    XYPos
      {
      X = 95
      }
    }
$!LineMap  [1]
  Name = 'Map 0'
  Assign
    {
    Zone = 1
    XAxisVar = 1
    YAxisVar = 2
    }
  Lines
    {
    Color = Red
    LineThickness = 0.8
    }
  Symbols
    {
    Color = Red
    FillColor = Red
    }
  BarCharts
    {
    Color = Red
    FillColor = Red
    }
  ErrorBars
    {
    Color = Red
    }
$!XYLineAxis 
  DepXToYRatio = 1
$!XYLineAxis 
  XDetail 1
    {
    ShowAxis = No
    RangeMin = 2.5941309928894042969
    RangeMax = 44.125551652574536377
    GRSpacing = 5
    }
$!XYLineAxis 
  YDetail 1
    {
    ShowAxis = No
    RangeMin = -3.6569619178771972656
    RangeMax = 3.5351591807842255299
    GRSpacing = 1
    }
$!SetStyleBase Config
