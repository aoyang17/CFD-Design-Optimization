#!MC 1410
$!SetStyleBase Factory
$!PlotType  = XYLine
$!FrameLayout 
  ShowBorder = No
  ShowHeader = No
  HeaderColor = Red
  XYPos
    {
    X = 1
    Y = 0.25
    }
  Width = 9
  Height = 5
$!ThreeDAxis 
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
$!GlobalTime 
  SolutionTime = 0
$!DeleteLineMaps 
$!ActiveLineMaps  =  [1]
$!GlobalLinePlot 
  DataLabels
    {
    DistanceSkip = 5
    }
  Legend
    {
    XYPos
      {
      X = 95
      }
    }
$!LineMap  [1]
  Name = 'Map 0'
  Assign
    {
    Zone = 6
    XAxisVar = 1
    YAxisVar = 10
    }
  Lines
    {
    Color = Red
    PatternLength = 5
    LineThickness = 1
    }
  Symbols
    {
    Color = Red
    FillColor = Red
    }
  BarCharts
    {
    Color = Red
    FillColor = Red
    }
  ErrorBars
    {
    Color = Red
    }
$!LineMap  [2]
  Name = 'Map 1'
  Assign
    {
    Zone = 7
    XAxisVar = 1
    YAxisVar = 10
    }
  Lines
    {
    Color = Custom6
    LinePattern = LongDash
    PatternLength = 5
    LineThickness = 1
    }
  Symbols
    {
    Color = Green
    FillColor = Green
    }
  BarCharts
    {
    Color = Green
    FillColor = Green
    }
  ErrorBars
    {
    Color = Green
    }
$!XYLineAxis 
  DepXToYRatio = 1
  ViewportPosition
    {
    X1 = 10
    Y1 = 1
    X2 = 95
    Y2 = 98
    }
  ViewportTopSnapTarget = 98
$!XYLineAxis 
  XDetail 1
    {
    ShowAxis = No
    RangeMin = 31.463090896606445312
    RangeMax = 38.754299604606629259
    GRSpacing = 1
    }
$!XYLineAxis 
  YDetail 1
    {
    RangeMin = -0.6851596832275390625
    RangeMax = 0.60422354995012284018
    IsReversed = Yes
    GRSpacing = 0.5
    TickLabel
      {
      TextShape
        {
        Height = 9
        }
      }
    Title
      {
      TitleMode = UseText
      Text = 'C<sub>P'
      TextShape
        {
        IsBold = No
        Height = 10
        }
      Offset = 5
      }
    AxisLine
      {
      Color = Custom2
      }
    }
$!SetStyleBase Config
